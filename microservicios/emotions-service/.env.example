# Identidad y puerto del microservicio (en Docker los fija compose.yaml).
SERVICE_NAME=emotions-service
PORT=3022

# Supabase Auth: URL del proyecto y clave publicable (no service_role).
# Solo se usan para verificar el token de sesión con auth.getUser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL para Prisma: conexión de ejecución y conexión directa.
# Usar la misma base y esquema que el backend principal, sin ejecutar migraciones aquí.
DATABASE_URL=
DIRECT_URL=
