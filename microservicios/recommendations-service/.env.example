SERVICE_NAME=recommendations-service
PORT=3024
# Docker DNS; para ejecución local usar http://localhost con el puerto correspondiente.
AUTH_SERVICE_URL=http://auth-service:3021
EMOTIONS_SERVICE_URL=http://emotions-service:3022
CATALOG_SERVICE_URL=http://catalog-service:3023
# En Render gratuito, el primer acceso puede tardar mientras despiertan dependencias.
REQUEST_TIMEOUT_MS=45000
UPSTREAM_TIMEOUT_MS=30000
