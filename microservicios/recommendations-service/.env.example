SERVICE_NAME=recommendations-service
PORT=3024
# Ejecución local con `npm run dev` en cada servicio. Con Docker Compose estas
# variables las reemplaza compose.yaml por los nombres internos (auth-service:3021, ...).
# Si aquí se dejan nombres de Docker fuera de Docker, el servicio no los resuelve y
# responde 503: el front muestra "El servicio no está disponible en este momento".
AUTH_SERVICE_URL=http://localhost:3021
EMOTIONS_SERVICE_URL=http://localhost:3022
CATALOG_SERVICE_URL=http://localhost:3023
# En Render gratuito, el primer acceso puede tardar mientras despiertan dependencias.
REQUEST_TIMEOUT_MS=45000
UPSTREAM_TIMEOUT_MS=30000
