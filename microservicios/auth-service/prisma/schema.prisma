generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                    String             @id
  email                 String?
  nombre                String?
  apellido              String?
  edad                  Int?
  datosJson             Json               @default("{}")
  creadoEn              DateTime           @default(now())
  animos                Animo[]
  favoritos             Favorito[]
  perfiles              Perfil[]
  invitacionesEnviadas  InvitacionPerfil[] @relation("InvitacionesEnviadas")
  invitacionesRecibidas InvitacionPerfil[] @relation("InvitacionesRecibidas")
}

model Perfil {
  id            String   @id @default(uuid())
  propietarioId String
  nombre        String
  avatar        String?
  esPrincipal   Boolean  @default(false)
  creadoEn      DateTime @default(now())
  propietario   Usuario  @relation(fields: [propietarioId], references: [id], onDelete: Cascade)

  @@index([propietarioId])
}

model InvitacionPerfil {
  id             String   @id @default(uuid())
  remitenteId    String
  destinatarioId String
  estado         String   @default("pendiente")
  creadoEn       DateTime @default(now())
  remitente      Usuario  @relation("InvitacionesEnviadas", fields: [remitenteId], references: [id], onDelete: Cascade)
  destinatario   Usuario  @relation("InvitacionesRecibidas", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@unique([remitenteId, destinatarioId])
  @@index([destinatarioId, estado])
}

model Animo {
  id        String   @id @default(uuid())
  usuarioId String
  emocion   String
  confianza Float
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Favorito {
  id        String   @id @default(uuid())
  usuarioId String
  tmdbId    Int
  tipo      String
  titulo    String
  poster    String?
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tmdbId, tipo])
}
