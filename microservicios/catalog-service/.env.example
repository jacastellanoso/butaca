# Identidad y puerto del microservicio (en Docker los fija compose.yaml).
SERVICE_NAME=catalog-service
PORT=3023

# Credencial privada de acceso a The Movie Database (API Key v3 o Read Access Token v4).
# Nunca escribir el valor real en este archivo; definirlo únicamente en .env.
TMDB_API_KEY=

# URLs base y tiempo máximo de espera para las consultas hacia TMDB.
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_TIMEOUT_MS=5000