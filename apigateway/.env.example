GATEWAY_PORT=3000
PROXY_TIMEOUT_MS=60000

AUTH_SERVICE_URL=http://localhost:3021
EMOTIONS_SERVICE_URL=http://localhost:3022
CATALOG_SERVICE_URL=http://localhost:3023
RECOMMENDATIONS_SERVICE_URL=http://localhost:3024
LIBRARY_SERVICE_URL=http://localhost:3025

# ── Seguridad (pf23) ─────────────────────────────────────────────────────
# Orígenes del front que pueden llamar al gateway (CORS), separados por coma.
# Nunca '*'. En Render: la URL HTTPS del front, por ejemplo
# CORS_ORIGINS=https://butaca-front.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proxies delante del gateway. Local/Docker: 0. Render: 1.
TRUST_PROXY=0

# Rate limit por IP: ventana en ms, máximo general y máximo de escrituras.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=60

# Tamaño máximo del body en bytes (32 KB).
MAX_BODY_BYTES=32768
