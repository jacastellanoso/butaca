# Puerto del backend (Vite usa 5173)
PORT=3010

# Supabase: los mismos valores que VITE_SUPABASE_URL y VITE_SUPABASE_PUBLISHABLE_KEY del front.
# El backend los usa solo para verificar el token de sesión del usuario.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Conexión privada de PostgreSQL en Supabase (Pooler para consultas de Prisma Client).
DATABASE_URL=

# Conexión directa de PostgreSQL en Supabase (requerida por Prisma para ejecutar migraciones).
DIRECT_URL=